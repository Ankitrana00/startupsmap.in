# =============================================================================
# StartupsMap.in — Environment Variable Template
# =============================================================================
# Copy this file to .env and fill in the real values.
# NEVER commit .env to git — it's gitignored by default.
# Restart the dev server after any change.
#
# Legend:
#   NEXT_PUBLIC_*  → available in browser (safe for public/anon keys only)
#   (no prefix)    → server-only, never reaches the client bundle
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (REQUIRED)
# Get from: supabase.com → your project → Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# Server-only service-role key (fix plan P0-3) — ALL server-side writes
# (submissions, admin inserts) go through this key because the anon key is
# read-only once RLS is applied (src/lib/db/schema/rls_policies.sql).
# Get from: Supabase → Settings → API → service_role. NEVER expose it to the
# client bundle — no NEXT_PUBLIC_ prefix, and never log it.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.yyyyy


# -----------------------------------------------------------------------------
# Redis / KV (optional but recommended in production)
# Backs rate limiting, idempotency keys (P3-1) and the startup-list cache (P3-2).
# Without it the app falls back to a bounded in-memory store, which only works
# for a single long-lived instance (fine for local dev, not for serverless prod).
# Get from: upstash.com → your database → REST API.
# Vercel's KV integration injects the same values as KV_REST_API_URL/TOKEN —
# both names are read (src/lib/cache/redis.ts).
# -----------------------------------------------------------------------------
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-rest-token

# -----------------------------------------------------------------------------
# Legacy Postgres connection (scripts/backup-db.mjs, scripts/restore-db.mjs,
# scripts/seed.mjs, src/lib/db/utils.ts only — NOT the Supabase client, and NOT
# required for the app to boot)
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:password@host:5432/startupsmap

# -----------------------------------------------------------------------------
# SMTP — submission & promotion emails (Gmail example)
# 1. Enable 2-Step Verification on the Gmail account
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Paste it below (16 characters, no spaces)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# One inbox for both flows (subject labels sort them: [Startup Submission] / [Promotion Ad])
SUBMISSIONS_TO=
# Optional: send promo leads to a different inbox
# PROMOTE_TO=

# -----------------------------------------------------------------------------
# Admin panel authentication
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@startupsmap.in
# bcrypt hash — generate with: npx bcrypt-cli "your-password"
ADMIN_PASSWORD=$2b$10$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# JWT secret for admin sessions — generate a random 32+ char string:
#   openssl rand -base64 32
#   OR: npx uuid
JWT_SECRET=

# -----------------------------------------------------------------------------
# App settings & Analytics (all optional)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# NEXT_PUBLIC_APP_NAME=StartupsMap.in
# NEXT_PUBLIC_APP_URL=https://startupsmap.in
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=startupsmap.in
# NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js

# -----------------------------------------------------------------------------
# Tile providers (server-only keys — used by /api/tiles/[z]/[x]/[y] proxy)
# Fallback chain: MapTiler (primary) → Mapbox (fallback) → OpenStreetMap (emergency)
# Leave a key empty and that provider is skipped; OSM always serves last, so the
# map never goes dark while keys are being provisioned/rotated.
#   MapTiler key:  maptiler.com → Account → API keys
#   Mapbox token:  mapbox.com → Account → Access tokens (public token, pk.*)
# -----------------------------------------------------------------------------
MAPTILER_API_KEY=
MAPBOX_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Sentry (optional — server-side auth token stays server-only)
# NEXT_PUBLIC_SENTRY_DSN=https://xxxxxx@xxxxxx.ingest.sentry.io/xxxxxx
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=your-org
# SENTRY_PROJECT=your-project
